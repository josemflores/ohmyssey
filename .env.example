# Server-side only. Copy this file to .env for local Athena hints.
# Never prefix the key with VITE_. That would bake it into the browser bundle.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite inside api/athenaLogic.js.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Where the study voyage loads LevelData JSON.
# Unset, the app calls GET /api/levels and falls back to the bundled mock.
# An empty value skips the network and uses the bundled mock only.
# This name needs the VITE_ prefix. It is not a secret. Never put the Gemini key behind VITE_.
# VITE_LEVELS_API_URL=https://example.com/api/levels

# Public OAuth client id for the "Log in with Google" button. Not a secret.
# Create a Web client at https://console.cloud.google.com/apis/credentials
# and allow this site's origin (http://127.0.0.1:5173 and the deployed URL).
# VITE_GOOGLE_CLIENT_ID=
